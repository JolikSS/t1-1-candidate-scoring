# Copy to .env; never commit your password or user documents.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=candidate_scoring
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-local-password
# CANDIDATE_DATA_DIR=A:/CandidateScoringData
# CANDIDATE_RUNTIME_DIR=A:/CandidateScoringData/candidate-runtime
# Native Windows fallback (otherwise Docker Compose is used):
# MONGODB_BIN=A:/CandidateScoringData/mongodb/bin/mongod.exe
# MONGODB_DATA_DIR=A:/CandidateScoringData/mongo-data-native
# NEO4J_HOME=A:/CandidateScoringData/neo4j-runtime/neo4j-community-5.26.0
# JAVA_HOME=path/to/java-21
